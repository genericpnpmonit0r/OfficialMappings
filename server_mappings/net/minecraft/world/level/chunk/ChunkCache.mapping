CLASS fr net/minecraft/world/level/chunk/ChunkCache
	FIELD a xLast I
	FIELD b zLast I
	FIELD c emptyChunk Lgd;
	FIELD d source Lay;
	FIELD e storage Lag;
	FIELD f chunks [Lgd;
	FIELD g level Lcp;
	FIELD h last Lgd;
	FIELD i xCenter I
	FIELD j yCenter I
	METHOD <init> (Lcp;Lag;Lay;)V
		ARG 1 level
		ARG 2 storage
		ARG 3 source
	METHOD a saveEntities (Lgd;)V
		ARG 1 lc
	METHOD b save (Lgd;)V
		ARG 1 lc
	METHOD c fits (II)Z
		ARG 1 x
		ARG 2 y
	METHOD d load (II)Lgd;
		ARG 1 x
		ARG 2 z
