CLASS fz net/minecraft/server/ServerChunkCache
	FIELD a droppedChunks Ljava/util/Set;
	FIELD b emptyChunk Lgd;
	FIELD c source Lay;
	FIELD d storage Lag;
	FIELD e loadedChunks Ljava/util/Map;
	FIELD f loadedChunkList Ljava/util/List;
	FIELD g level Lcv;
	METHOD <init> (Lcv;Lag;Lay;)V
		ARG 1 level
		ARG 2 storage
		ARG 3 source
	METHOD a saveEntities (Lgd;)V
		ARG 1 chunk
	METHOD b save (Lgd;)V
