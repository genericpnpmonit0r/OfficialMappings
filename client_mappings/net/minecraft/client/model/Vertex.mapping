CLASS gn net/minecraft/client/model/Vertex
	METHOD <init> (FFFFF)V
		ARG 1 x
		ARG 2 y
		ARG 3 z
		ARG 4 u
		ARG 5 v
	METHOD <init> (Lbb;FF)V
		ARG 1 vertex
		ARG 2 u
		ARG 3 v
	METHOD <init> (Lgn;FF)V
		ARG 1 vertex
		ARG 2 u
		ARG 3 v
	METHOD a remap (FF)Lgn;
		ARG 1 u
		ARG 2 v
	FIELD a pos Lbb;
	FIELD b u F
	FIELD c v F
